# 이 파일은 커밋됨(변수 이름 목록). 로컬 값은 .env.local 에 (커밋 안 됨, setup.sh가 이 파일을 복사해 만듦)
# dialogue 모듈 담당자가 실제 LLM을 붙일 때 사용
ANTHROPIC_API_KEY=

# 공용 개발 DB (Supabase 개발 프로젝트). scripts/run-local.sh --shared 가 이 세 줄만 읽는다 (ADR 0017)
# Connect > Type: JDBC, Method: Session pooler(5432). 대시보드 문자열의 ?user=...&password=... 는 빼고 따옴표 없이 값만
# 예) CAPSULE_DEV_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#     CAPSULE_DEV_DB_USERNAME=postgres.<개발 project-ref>
CAPSULE_DEV_DB_URL=
CAPSULE_DEV_DB_USERNAME=
CAPSULE_DEV_DB_PASSWORD=

# --- 배포(prod 프로필) 전용: 값은 배포 환경 시크릿에만 둔다 (ADR 0016, application-prod.yml) ---
# 로컬에서는 쓰지 않으므로 주석으로 둔다. 빈 값이 들어가면 local 프로필의 기본값을 덮어 로컬 실행이 깨진다
# SPRING_PROFILES_ACTIVE=prod
# Supabase Connect > Type: JDBC, Method: Session pooler 에서 복사. user · password는 URL에서 빼고 아래에 따로
# 예) jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=
# CAPSULE_DB_POOL_SIZE=5
# CAPSULE_CDN_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<버킷 이름>
# CAPSULE_JWT_SECRET=          (32바이트 이상, ADR 0011)
# CAPSULE_CORS_ORIGINS=        (프론트 주소, 쉼표로 여러 개)
# CAPSULE_KAKAO_REST_API_KEY=  (카카오 디벨로퍼스 > 앱 키 > REST API 키)
# CAPSULE_KAKAO_CLIENT_SECRET= (Client Secret을 켰을 때만)
# 인증 메일 (ADR 0020). 개발 서버도 넣으면 실제 발송
# CAPSULE_BREVO_KEY=           (Brevo > SMTP & API > API Keys)
# CAPSULE_MAIL_FROM=           (Brevo에서 인증한 보내는 사람 이메일)
# Redis는 Supabase에 없어서 따로 정함 (ADR 0016 '남은 일')
# SPRING_DATA_REDIS_HOST=
# SPRING_DATA_REDIS_PORT=
# SPRING_DATA_REDIS_PASSWORD=
