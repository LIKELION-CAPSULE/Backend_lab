# Lombok 설정 (ADR 0029)
config.stopBubbling = true
# 생성된 코드에 @Generated를 붙인다 (커버리지 도구를 붙이면 집계에서 빠짐)
lombok.addLombokGeneratedAnnotation = true
# @RequiredArgsConstructor가 필드의 @Value를 생성자 파라미터로 옮긴다 (설정값 주입도 생성자 직접 작성 없이)
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
# 쓰지 않기로 한 기능: 엔티티에 @Data · @Setter, 동작이 숨는 @SneakyThrows · val
lombok.data.flagUsage = error
lombok.setter.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.val.flagUsage = error
